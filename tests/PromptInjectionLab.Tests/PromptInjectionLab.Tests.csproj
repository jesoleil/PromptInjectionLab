<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Zero-dependency test runner. xUnit would require a NuGet restore, which is
    blocked in the build sandbox, so tests run via a small built-in runner
    (see Program.cs / Check.cs). On a machine with internet this can be migrated
    to xUnit without changing the assertions.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PromptInjectionLab.Core\PromptInjectionLab.Core.csproj" />
  </ItemGroup>

</Project>
