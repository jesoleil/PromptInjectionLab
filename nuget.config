<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources are restricted on purpose.
  Microsoft.Extensions.* (DI, Hosting, Options, Http, Logging, Configuration)
  come from the installed Microsoft.AspNetCore.App shared framework via
  <FrameworkReference>, so they need no packages.

  The only external package is PdfPig (Apache-2.0, PDF text extraction).
  packageSourceMapping allows nuget.org to supply ONLY that package id, so a
  typo or an unexpected transitive package fails the restore instead of being
  pulled in silently. To add another package, add its id pattern below.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="PdfPig" />
    </packageSource>
  </packageSourceMapping>
</configuration>
