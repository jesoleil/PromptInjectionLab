<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources are intentionally cleared.
  This prototype has NO external NuGet dependencies: Microsoft.Extensions.*
  (DI, Hosting, Options, Http, Logging, Configuration) come from the installed
  Microsoft.AspNetCore.App shared framework via <FrameworkReference>, so the
  solution restores and builds fully offline.

  On a machine with normal internet access you may delete this file to restore
  the default nuget.org source (e.g. if you later add packages such as xUnit,
  PdfPig or DocumentFormat.OpenXml in a later phase).
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
